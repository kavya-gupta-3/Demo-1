---
layout: base.njk
title: "Investment Club | Michael's Investment Club"
description: "Updates, activities, and news about Michael's Investment Club."
---

<div class="page-header category-hero">
  <div class="container">
    <span class="eyebrow">Category</span>
    <h1>Investment Club</h1>
    <p class="lead" style="margin:0 auto;">Updates, activities, and news about Michael's Investment Club and our student community.</p>
  </div>
</div>

<main>
  <div class="container" style="padding-top:60px;padding-bottom:80px;">
    <div class="post-grid">
      {%- for post in collections.posts | sortByDate %}
      {%- if post.data.category == "Investment Club" %}
      <a class="post-card reveal" href="{{ post.url }}">
        <div class="post-card-image placeholder">
          <span class="placeholder-icon">🏦</span>
          <span class="category-badge badge-investment-club">Investment Club</span>
        </div>
        <div class="post-card-body">
          <div class="post-card-meta">
            <span>{{ post.data.date | dateFormat }}</span>
            <span class="dot"></span>
            <span>{{ post.templateContent | readingTime }}</span>
          </div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary }}</p>
          <span class="read-more">Read article →</span>
        </div>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>

    {%- set hasClub = false %}
    {%- for post in collections.posts %}
      {%- if post.data.category == "Investment Club" %}
        {%- set hasClub = true %}
      {%- endif %}
    {%- endfor %}
    {%- if not hasClub %}
    <div style="text-align:center;padding:60px 0;color:var(--muted);">
      <p style="font-size:1.15rem;">No Investment Club articles published yet. Check back soon!</p>
      <a href="/insights/" class="btn btn-ghost mt-3">← View All Insights</a>
    </div>
    {%- endif %}
  </div>
</main>
