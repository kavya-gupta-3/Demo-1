<!-- ==================== SIMULATOR SECTION ==================== -->
<section class="section-alt">
  <div class="container">
    <div class="sim-grid">
      <div class="reveal">
        <span class="eyebrow">Hands-on Learning</span>
        <h2>Think like an investor without risking real money</h2>
        <p class="lead">
          Members can begin with a hypothetical $100,000 portfolio and make investment decisions throughout the semester.
          Performance matters, but the larger goal is to explain the thesis, understand the risk, learn from mistakes,
          and connect portfolio results to real-world market events.
        </p>
      </div>
      <div class="stat-box reveal-scale reveal-delay-1">
        <div class="stat-label">Sample Virtual Portfolio</div>
        <div class="stat-value">$100,000</div>
        <div class="stat-note">Educational simulation • No real capital required</div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== FINANCIAL LITERACY CALLOUT ==================== -->
<section>
  <div class="container">
    <div class="callout reveal-scale">
      <span class="eyebrow">Financial Literacy Project</span>
      <h2>Making finance easier to understand</h2>
      <p class="lead mb-0">
        Beyond the club, Michael uses social media to share approachable explanations of investing, personal finance,
        economic trends, and market concepts. The goal is to help students build confidence with financial topics
        they may not otherwise encounter in a traditional high-school curriculum.
      </p>
    </div>
  </div>
</section>

<!-- ==================== MARKET INSIGHTS (Latest Posts) ==================== -->
<section id="insights" class="section-dark">
  <div class="container">
    <div class="section-header reveal">
      <span class="eyebrow">New & Noteworthy</span>
      <h2>Market Insights</h2>
      <p class="lead">
        I use this space to share short observations on markets, companies, economic developments,
        and financial-literacy topics. These posts are educational and reflect my own learning process.
      </p>
    </div>
    <div class="post-grid">
      {%- for post in collections.posts | sortByDate | limit(3) %}
      <a class="post-card reveal{% if loop.index > 1 %} reveal-delay-{{ loop.index - 1 }}{% endif %}" href="{{ post.url }}">
        <div class="post-card-image placeholder">
          <span class="placeholder-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </span>
          {% if post.data.category %}
          <span class="category-badge badge-{{ post.data.category | slug }}">{{ post.data.category }}</span>
          {% else %}
          <span class="category-badge badge-market-insights">Market Insights</span>
          {% endif %}
        </div>
        <div class="post-card-body">
          <div class="post-card-meta">
            <span>{{ post.data.date | dateFormat }}</span>
            <span class="dot"></span>
            <span>{{ post.templateContent | readingTime }}</span>
          </div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary }}</p>
          <span class="read-more">Read article
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      </a>
      {%- endfor %}
    </div>
    <div class="mt-4 reveal">
      <a href="/insights/" class="btn btn-outline">View All Market Insights
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

